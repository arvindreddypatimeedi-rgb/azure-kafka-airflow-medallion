		{
			"name": "[concat(parameters('factoryName'), '/DF_Bronze_To_Silver')]",
			"type": "Microsoft.DataFactory/factories/dataflows",
			"apiVersion": "2018-06-01",
			"properties": {
				"type": "MappingDataFlow",
				"typeProperties": {
					"sources": [
						{
							"dataset": {
								"referenceName": "DS_Bronze_EventHub_Avro",
								"type": "DatasetReference"
							},
							"name": "source1"
						}
					],
					"sinks": [
						{
							"dataset": {
								"referenceName": "DelimitedText1",
								"type": "DatasetReference"
							},
							"name": "silver"
						}
					],
					"transformations": [
						{
							"name": "derivedColumn1"
						},
						{
							"name": "parse1"
						}
					],
					"scriptLines": [
						"source(output(",
						"          SequenceNumber as long,",
						"          Offset as string,",
						"          EnqueuedTimeUtc as string,",
						"          SystemProperties as [string,string],",
						"          Properties as [string,string],",
						"          Body as string",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     ignoreNoFilesFound: false,",
						"     wildcardPaths:['bronze/eventhub-capture/evhns-retail-med-dev/retail-orders/*/*/*/*/*/*/*.avro']) ~> source1",
						"parse1 derive(quantity = toInteger(parsed_body.quantity),",
						"          unit_price = toDecimal(parsed_body.unit_price,18,2),",
						"          order_date = toDate(parsed_body.order_date),",
						"          total_amount = toDecimal(parsed_body.quantity) * toDecimal(parsed_body.unit_price)) ~> derivedColumn1",
						"source1 parse(parsed_body = Body ? (order_id as string,",
						"          customer_id as string,",
						"          customer_name as string,",
						"          product as string,",
						"          quantity as string,",
						"          unit_price as string,",
						"          order_date as string),",
						"     format: 'json',",
						"     documentForm: 'singleDocument') ~> parse1",
						"derivedColumn1 sink(allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     truncate: true,",
						"     umask: 0022,",
						"     preCommands: [],",
						"     postCommands: [],",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true,",
						"     mapColumn(",
						"          quantity,",
						"          unit_price,",
						"          order_date,",
						"          total_amount,",
						"          order_id = parsed_body.order_id,",
						"          customer_id = parsed_body.customer_id,",
						"          customer_name = parsed_body.customer_name,",
						"          product = parsed_body.product",
						"     )) ~> silver"
					]
				}
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/datasets/DS_Bronze_EventHub_Avro')]",
				"[concat(variables('factoryId'), '/datasets/DelimitedText1')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/DF_Silver_To_Gold')]",
			"type": "Microsoft.DataFactory/factories/dataflows",
			"apiVersion": "2018-06-01",
			"properties": {
				"type": "MappingDataFlow",
				"typeProperties": {
					"sources": [
						{
							"dataset": {
								"referenceName": "DelimitedText1",
								"type": "DatasetReference"
							},
							"name": "source1"
						}
					],
					"sinks": [
						{
							"dataset": {
								"referenceName": "DelimitedText3",
								"type": "DatasetReference"
							},
							"name": "goldset"
						}
					],
					"transformations": [
						{
							"name": "customersales"
						}
					],
					"scriptLines": [
						"source(output(",
						"          quantity as short,",
						"          unit_price as double,",
						"          order_date as date,",
						"          total_amount as double,",
						"          order_id as short,",
						"          customer_id as string,",
						"          customer_name as string,",
						"          product as string",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     ignoreNoFilesFound: false) ~> source1",
						"source1 aggregate(groupBy(customer_id,",
						"          customer_name),",
						"     total_orders = count(order_id),",
						"          total_quantity = sum(toInteger(quantity)),",
						"          total_sales = sum(toInteger(total_amount))) ~> customersales",
						"customersales sink(allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     truncate: true,",
						"     umask: 0022,",
						"     preCommands: [],",
						"     postCommands: [],",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true) ~> goldset"
					]
				}
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/datasets/DelimitedText1')]",
				"[concat(variables('factoryId'), '/datasets/DelimitedText3')]"
			]
		}
	]
